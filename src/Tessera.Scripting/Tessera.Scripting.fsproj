<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Tessera.Scripting</RootNamespace>
    <Description>C# scripts against a model's TOM, compiled with Roslyn in memory (`tess csharp`). Self-contained: drop this project and the command to remove scripting.</Description>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="CsScript.fs" />
  </ItemGroup>

  <ItemGroup>
    <!-- The C# compiler API (not Microsoft.CodeAnalysis.CSharp.Scripting, which needs assemblies on disk
         and so fails in the single-file binary: see docs/scripting-design.md). -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Tessera.Core/Tessera.Core.fsproj" />
  </ItemGroup>

</Project>
